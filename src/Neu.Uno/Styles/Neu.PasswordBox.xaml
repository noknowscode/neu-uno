<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    PasswordBox. Same well and ring anatomy as Neu.TextBox; the differences are
    the reveal button in place of the delete button, and PasswordBox's own
    ButtonStates group driving it.

    The reveal button is a ToggleButton by contract - PasswordBox resolves
    RevealButton as one and drives the reveal from IsPressed - so it cannot use
    the Neu ToggleButton style, which would put a raised slab inside the well.
    It is glyph-only: an eye outline in secondary ink, amber while revealing.
  -->

  <Style x:Key="NeuPasswordRevealButtonStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkSecondaryBrush}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Iris.Fill" Value="{ThemeResource NeuInkBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Iris.Fill" Value="{ThemeResource NeuAccentBrush}" />
                    <Setter Target="Lid.Stroke" Value="{ThemeResource NeuAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Eye.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="Eye"
                  Width="16"
                  Height="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <!-- Two circular arcs, never an elliptical one: Uno's path
                   mini-language throws on rx != ry at parse time. -->
              <Path x:Name="Lid"
                    Data="M0,6 A7,7 0 0 1 16,6 A7,7 0 0 1 0,6 Z"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="1.5"
                    StrokeLineJoin="Round" />
              <Ellipse x:Name="Iris"
                       Width="5"
                       Height="5"
                       Fill="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NeuPasswordBoxStyle" TargetType="PasswordBox">
    <Setter Property="Background" Value="{ThemeResource NeuSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="SelectionHighlightColor" Value="{ThemeResource NeuAccentBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource NeuRadiusMd}" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="MinHeight" Value="{ThemeResource NeuTouchTargetMin}" />
    <Setter Property="MinWidth" Value="144" />
    <Setter Property="FontSize" Value="{ThemeResource NeuBodyFontSize}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Grid x:Name="Root">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />

                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Well.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Shadows" Value="{ThemeResource NeuFocusRing}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentElement.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                    <Setter Target="PlaceholderTextContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                    <Setter Target="HeaderContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <VisualStateGroup x:Name="ButtonStates">
                <VisualState x:Name="ButtonVisible">
                  <VisualState.Setters>
                    <Setter Target="RevealButton.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ButtonCollapsed" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <ContentPresenter x:Name="HeaderContentPresenter"
                              Grid.Row="0"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{ThemeResource NeuInkSecondaryBrush}"
                              FontSize="{ThemeResource NeuLabelFontSize}"
                              Margin="0,0,0,8"
                              Visibility="Collapsed"
                              AutomationProperties.AccessibilityView="Raw" />

            <Grid Grid.Row="1" MinHeight="{ThemeResource NeuTouchTargetMin}">
              <utu:ShadowContainer x:Name="FocusRing"
                                   Background="{TemplateBinding Background}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   Shadows="{ThemeResource NeuFlat}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}" />
              </utu:ShadowContainer>

              <utu:ShadowContainer x:Name="Well"
                                   Background="{TemplateBinding Background}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   Shadows="{ThemeResource NeuInsetSm}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border x:Name="BorderElement"
                          Grid.ColumnSpan="2"
                          Background="Transparent"
                          CornerRadius="{TemplateBinding CornerRadius}" />

                  <TextBlock x:Name="PlaceholderTextContentPresenter"
                             Grid.Column="0"
                             Text="{TemplateBinding PlaceholderText}"
                             Foreground="{ThemeResource NeuInkSecondaryBrush}"
                             Padding="{TemplateBinding Padding}"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False" />

                  <ScrollViewer x:Name="ContentElement"
                                Grid.Column="0"
                                Padding="{TemplateBinding Padding}"
                                HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                VerticalAlignment="Center"
                                ZoomMode="Disabled"
                                AutomationProperties.AccessibilityView="Raw" />

                  <ToggleButton x:Name="RevealButton"
                                Grid.Column="1"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource NeuPasswordRevealButtonStyle}"
                                Visibility="Collapsed"
                                AutomationProperties.AccessibilityView="Raw" />
                </Grid>
              </utu:ShadowContainer>
            </Grid>

            <ContentPresenter x:Name="DescriptionPresenter"
                              Grid.Row="2"
                              Content="{TemplateBinding Description}"
                              Foreground="{ThemeResource NeuInkSecondaryBrush}"
                              FontSize="{ThemeResource NeuLabelFontSize}"
                              Margin="0,5,0,0"
                              AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
