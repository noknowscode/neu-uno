<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    TextBox. An InsetSm well - the field is a hole in the slab, not an extrusion -
    with the focus ring as a second ShadowContainer layered behind it, spread 2,
    blur 0. This is the anatomy the whole input family shares.

    Neither container carries an explicit size. Both fill the same single-cell
    Grid, which is sized by the well's content, and a ShadowContainer that fills
    a cell does stretch its child - so the empty ring Grid comes out the same
    size as the field. (A container with an explicit size does not stretch its
    child; see the RadioButton note in decisions.md.)

    ContentElement has to be a ScrollViewer and BorderElement a Border: TextBox
    resolves both by name and type on apply-template. BorderElement is kept
    transparent - the well draws the field, and a Background on the container's
    child would suppress the inner shadow (rule 1).

    Disabled keeps the well at InsetSm and fades only the ink. Flat would erase
    an empty field completely, since canvas and surface are one colour and a
    field has no content of its own to fall back on - the same reason the slider
    thumb stays raised when disabled.
  -->

  <Style x:Key="NeuTextBoxDeleteButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkSecondaryBrush}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Glyph.Stroke" Value="{ThemeResource NeuInkBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Glyph.Stroke" Value="{ThemeResource NeuAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Glyph.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Path x:Name="Glyph"
                  Data="M0,0 L8,8 M8,0 L0,8"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NeuTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{ThemeResource NeuSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="SelectionHighlightColor" Value="{ThemeResource NeuAccentBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource NeuRadiusMd}" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="MinHeight" Value="{ThemeResource NeuTouchTargetMin}" />
    <Setter Property="MinWidth" Value="144" />
    <Setter Property="FontSize" Value="{ThemeResource NeuBodyFontSize}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid x:Name="Root">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />

                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Well.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Shadows" Value="{ThemeResource NeuFocusRing}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentElement.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                    <Setter Target="PlaceholderTextContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                    <Setter Target="HeaderContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <VisualStateGroup x:Name="ButtonStates">
                <VisualState x:Name="ButtonVisible">
                  <VisualState.Setters>
                    <Setter Target="DeleteButton.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ButtonCollapsed" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <ContentPresenter x:Name="HeaderContentPresenter"
                              Grid.Row="0"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{ThemeResource NeuInkSecondaryBrush}"
                              FontSize="{ThemeResource NeuLabelFontSize}"
                              Margin="0,0,0,8"
                              Visibility="Collapsed"
                              AutomationProperties.AccessibilityView="Raw" />

            <Grid Grid.Row="1" MinHeight="{ThemeResource NeuTouchTargetMin}">
              <utu:ShadowContainer x:Name="FocusRing"
                                   Background="{TemplateBinding Background}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   Shadows="{ThemeResource NeuFlat}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}" />
              </utu:ShadowContainer>

              <utu:ShadowContainer x:Name="Well"
                                   Background="{TemplateBinding Background}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   Shadows="{ThemeResource NeuInsetSm}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border x:Name="BorderElement"
                          Grid.ColumnSpan="2"
                          Background="Transparent"
                          CornerRadius="{TemplateBinding CornerRadius}" />

                  <TextBlock x:Name="PlaceholderTextContentPresenter"
                             Grid.Column="0"
                             Text="{TemplateBinding PlaceholderText}"
                             Foreground="{ThemeResource NeuInkSecondaryBrush}"
                             Padding="{TemplateBinding Padding}"
                             TextAlignment="{TemplateBinding TextAlignment}"
                             TextWrapping="{TemplateBinding TextWrapping}"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False" />

                  <ScrollViewer x:Name="ContentElement"
                                Grid.Column="0"
                                Padding="{TemplateBinding Padding}"
                                HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                                IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                                IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                VerticalAlignment="Center"
                                ZoomMode="Disabled"
                                AutomationProperties.AccessibilityView="Raw" />

                  <Button x:Name="DeleteButton"
                          Grid.Column="1"
                          Margin="0,0,5,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource NeuTextBoxDeleteButtonStyle}"
                          Visibility="Collapsed"
                          AutomationProperties.AccessibilityView="Raw" />
                </Grid>
              </utu:ShadowContainer>
            </Grid>

            <ContentPresenter x:Name="DescriptionPresenter"
                              Grid.Row="2"
                              Content="{TemplateBinding Description}"
                              Foreground="{ThemeResource NeuInkSecondaryBrush}"
                              FontSize="{ThemeResource NeuLabelFontSize}"
                              Margin="0,5,0,0"
                              AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
