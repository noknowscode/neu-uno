<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    Button. Rest RaisedMd; PointerOver keeps the depth and lifts the surface
    +2% lightness; Pressed runs the signature Raised -> Flat -> Inset with a 0.98
    scale; Disabled is Flat with ink at 38%. Focus is a second ShadowContainer
    behind the surface wearing NeuFocusRing.

    Two templates, not one: the accent variant hovers to NeuAccentHoverBrush and
    a VisualState Setter cannot TemplateBind, so the hover brush has to be baked
    into each template. Everything else is identical between them.

    The press storyboard animates Shadows with discrete keyframes - Flat at 0,
    Inset at 75ms - and the release transition mirrors it. Shadows is an object
    property and cannot tween; the midpoint is the tween.
  -->

  <Style x:Key="NeuButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource NeuSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource NeuRadiusMd}" />
    <Setter Property="Padding" Value="21,0" />
    <Setter Property="MinHeight" Value="{ThemeResource NeuTouchTargetMin}" />
    <Setter Property="MinWidth" Value="89" />
    <Setter Property="FontSize" Value="{ThemeResource NeuBodyFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                  <!-- Release: Inset -> Flat -> Raised, and the scale eases back. -->
                  <VisualTransition From="Pressed" GeneratedDuration="0:0:0.150">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface"
                                                     Storyboard.TargetProperty="Shadows">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NeuFlat}" />
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.075" Value="{ThemeResource NeuRaisedMd}" />
                      </ObjectAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale"
                                                     Storyboard.TargetProperty="ScaleX">
                        <DiscreteDoubleKeyFrame KeyTime="0" Value="{ThemeResource NeuPressScale}" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="{StaticResource NeuEaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale"
                                                     Storyboard.TargetProperty="ScaleY">
                        <DiscreteDoubleKeyFrame KeyTime="0" Value="{ThemeResource NeuPressScale}" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="{StaticResource NeuEaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Normal" />

                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Surface.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface"
                                                   Storyboard.TargetProperty="Shadows">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NeuFlat}" />
                      <DiscreteObjectKeyFrame KeyTime="0:0:0.075" Value="{ThemeResource NeuInsetSm}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale"
                                                   Storyboard.TargetProperty="ScaleX">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="{ThemeResource NeuPressScale}" KeySpline="{StaticResource NeuEaseSmooth}" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale"
                                                   Storyboard.TargetProperty="ScaleY">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="{ThemeResource NeuPressScale}" KeySpline="{StaticResource NeuEaseSmooth}" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>

                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuFlat}" />
                    <Setter Target="ContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Shadows" Value="{ThemeResource NeuFocusRing}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <utu:ShadowContainer x:Name="FocusRing"
                                 Background="{TemplateBinding Background}"
                                 CornerRadius="{TemplateBinding CornerRadius}"
                                 Shadows="{ThemeResource NeuFlat}">
              <Grid CornerRadius="{TemplateBinding CornerRadius}" />
            </utu:ShadowContainer>

            <utu:ShadowContainer x:Name="Surface"
                                 Background="{TemplateBinding Background}"
                                 CornerRadius="{TemplateBinding CornerRadius}"
                                 Shadows="{ThemeResource NeuRaisedMd}">
              <Grid CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  AutomationProperties.AccessibilityView="Raw" />
              </Grid>
            </utu:ShadowContainer>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The one amber fill per view. Same anatomy, accent brushes, accent hover. -->
  <Style x:Key="NeuAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource NeuButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource NeuAccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuOnAccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                  <VisualTransition From="Pressed" GeneratedDuration="0:0:0.150">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface"
                                                     Storyboard.TargetProperty="Shadows">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NeuFlat}" />
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.075" Value="{ThemeResource NeuRaisedMd}" />
                      </ObjectAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale"
                                                     Storyboard.TargetProperty="ScaleX">
                        <DiscreteDoubleKeyFrame KeyTime="0" Value="{ThemeResource NeuPressScale}" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="{StaticResource NeuEaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale"
                                                     Storyboard.TargetProperty="ScaleY">
                        <DiscreteDoubleKeyFrame KeyTime="0" Value="{ThemeResource NeuPressScale}" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="{StaticResource NeuEaseSmooth}" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Normal" />

                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Surface.Background" Value="{ThemeResource NeuAccentHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface"
                                                   Storyboard.TargetProperty="Shadows">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NeuFlat}" />
                      <DiscreteObjectKeyFrame KeyTime="0:0:0.075" Value="{ThemeResource NeuInsetSm}" />
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale"
                                                   Storyboard.TargetProperty="ScaleX">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="{ThemeResource NeuPressScale}" KeySpline="{StaticResource NeuEaseSmooth}" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressScale"
                                                   Storyboard.TargetProperty="ScaleY">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="{ThemeResource NeuPressScale}" KeySpline="{StaticResource NeuEaseSmooth}" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>

                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuFlat}" />
                    <Setter Target="ContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Shadows" Value="{ThemeResource NeuFocusRing}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <utu:ShadowContainer x:Name="FocusRing"
                                 Background="{TemplateBinding Background}"
                                 CornerRadius="{TemplateBinding CornerRadius}"
                                 Shadows="{ThemeResource NeuFlat}">
              <Grid CornerRadius="{TemplateBinding CornerRadius}" />
            </utu:ShadowContainer>

            <utu:ShadowContainer x:Name="Surface"
                                 Background="{TemplateBinding Background}"
                                 CornerRadius="{TemplateBinding CornerRadius}"
                                 Shadows="{ThemeResource NeuRaisedMd}">
              <Grid CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  AutomationProperties.AccessibilityView="Raw" />
              </Grid>
            </utu:ShadowContainer>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Pill. Half the 44 touch-target height, written as a number rather than
    NeuRadiusPill because the Skia renderer turns 999 into an oval (decisions.md).
  -->
  <Style x:Key="NeuPillButtonStyle" TargetType="Button" BasedOn="{StaticResource NeuButtonStyle}">
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="34,0" />
  </Style>

</ResourceDictionary>
