<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    ComboBox. The closed box is the same InsetSm well and focus ring as the text
    inputs. The drop-down is the one place a raised surface floats over the
    slab: RaisedLg, matching the dialog depth.

    ComboBox resolves Popup, PopupBorder, ScrollViewer and ItemsPresenter by
    name, so all four are present. The popup's ScrollViewer is the element the
    control measures against MaxDropDownHeight.

    The chevron is a Path, not the stock AnimatedIcon: an AnimatedIcon needs a
    generated Lottie source, and a two-segment stroke rotates just as well. It
    turns 180 degrees while open, which is the second channel on the open state.

    Item selection is an amber leading bar, matching the ListViewItem rule in
    the Interaction Brief rather than a filled row - a saturated fill here would
    break "one amber fill per view".
  -->

  <Style x:Key="NeuComboBoxItemStyle" TargetType="ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="MinHeight" Value="{ThemeResource NeuTouchTargetMin}" />
    <Setter Property="FontSize" Value="{ThemeResource NeuBodyFontSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid x:Name="Root" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="SelectionBar.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedUnfocused">
                  <VisualState.Setters>
                    <Setter Target="SelectionBar.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="SelectionBar.Opacity" Value="1" />
                    <Setter Target="Root.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPressed">
                  <VisualState.Setters>
                    <Setter Target="SelectionBar.Opacity" Value="1" />
                    <Setter Target="Root.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Rectangle x:Name="SelectionBar"
                       Grid.Column="0"
                       Width="3"
                       Height="21"
                       RadiusX="1.5"
                       RadiusY="1.5"
                       Margin="5,0,0,0"
                       Fill="{ThemeResource NeuAccentBrush}"
                       VerticalAlignment="Center"
                       Opacity="0" />

            <ContentPresenter x:Name="ContentPresenter"
                              Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NeuComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Background" Value="{ThemeResource NeuSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource NeuRadiusMd}" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="MinHeight" Value="{ThemeResource NeuTouchTargetMin}" />
    <Setter Property="MinWidth" Value="144" />
    <Setter Property="FontSize" Value="{ThemeResource NeuBodyFontSize}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource NeuComboBoxItemStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />

                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Well.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Well.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                    <Setter Target="DropDownGlyph.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                    <Setter Target="HeaderContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="FocusedDropDown" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Shadows" Value="{ThemeResource NeuFocusRing}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <VisualStateGroup x:Name="DropDownStates">
                <VisualState x:Name="Closed" />
                <VisualState x:Name="Opened">
                  <VisualState.Setters>
                    <Setter Target="GlyphRotate.Angle" Value="180" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <ContentPresenter x:Name="HeaderContentPresenter"
                              Grid.Row="0"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{ThemeResource NeuInkSecondaryBrush}"
                              FontSize="{ThemeResource NeuLabelFontSize}"
                              Margin="0,0,0,8"
                              Visibility="Collapsed"
                              AutomationProperties.AccessibilityView="Raw" />

            <Grid Grid.Row="1" MinHeight="{ThemeResource NeuTouchTargetMin}">
              <utu:ShadowContainer x:Name="FocusRing"
                                   Background="{TemplateBinding Background}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   Shadows="{ThemeResource NeuFlat}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}" />
              </utu:ShadowContainer>

              <utu:ShadowContainer x:Name="Well"
                                   Background="{TemplateBinding Background}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   Shadows="{ThemeResource NeuInsetSm}">
                <Grid CornerRadius="{TemplateBinding CornerRadius}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock x:Name="PlaceholderTextBlock"
                             Grid.Column="0"
                             Text="{TemplateBinding PlaceholderText}"
                             Foreground="{ThemeResource NeuInkSecondaryBrush}"
                             Padding="{TemplateBinding Padding}"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False" />

                  <ContentPresenter x:Name="ContentPresenter"
                                    Grid.Column="0"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />

                  <Path x:Name="DropDownGlyph"
                        Grid.Column="1"
                        Data="M0,0 L5,5 L10,0"
                        Stroke="{ThemeResource NeuInkSecondaryBrush}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Margin="0,0,13,0"
                        RenderTransformOrigin="0.5,0.5"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Path.RenderTransform>
                      <RotateTransform x:Name="GlyphRotate" />
                    </Path.RenderTransform>
                  </Path>
                </Grid>
              </utu:ShadowContainer>
            </Grid>

            <Popup x:Name="Popup">
              <utu:ShadowContainer x:Name="PopupSurface"
                                   Background="{ThemeResource NeuSurfaceBrush}"
                                   CornerRadius="{ThemeResource NeuRadiusMd}"
                                   Shadows="{ThemeResource NeuRaisedLg}">
                <Border x:Name="PopupBorder"
                        CornerRadius="{ThemeResource NeuRadiusMd}"
                        Padding="0,5">
                  <ScrollViewer x:Name="ScrollViewer"
                                MinWidth="{Binding TemplateSettings.DropDownContentMinWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                ZoomMode="Disabled"
                                AutomationProperties.AccessibilityView="Raw">
                    <ItemsPresenter x:Name="ItemsPresenter" />
                  </ScrollViewer>
                </Border>
              </utu:ShadowContainer>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
