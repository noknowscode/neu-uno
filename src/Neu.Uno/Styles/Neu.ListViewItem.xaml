<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    ListViewItem. RaisedSm at rest, InsetSm plus an amber leading bar when
    selected - depth alone never carries a state, and a filled row would spend
    the view's one amber fill.

    The 13 bottom margin is not decoration. Rule 7 is offset < gap, and rows in
    a list are otherwise adjacent: at RaisedSm the shade reaches 3px past the
    edge, so touching rows would print their shadows on each other. 13 is the
    smallest Fibonacci gap that clears it, which makes a Neu list inherently
    airier than a Fluent one.

    Every row is a ShadowContainer, so a long list is a long list of Skia
    canvases. Perf is measured in the gallery's 200-row specimen; if it stalls,
    the documented fallbacks are dropping the blur or taking rows to NeuFlat and
    letting the amber bar carry selection alone.
  -->

  <Style x:Key="NeuListViewItemStyle" TargetType="ListViewItem">
    <Setter Property="Background" Value="{ThemeResource NeuSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource NeuRadiusSm}" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="Margin" Value="0,0,0,13" />
    <Setter Property="MinHeight" Value="{ThemeResource NeuTouchTargetMin}" />
    <Setter Property="FontSize" Value="{ThemeResource NeuBodyFontSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid x:Name="ContentBorder">

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />

                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Surface.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuInsetSm}" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuInsetSm}" />
                    <Setter Target="SelectionBar.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="PointerOverSelected">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuInsetSm}" />
                    <Setter Target="Surface.Background" Value="{ThemeResource NeuSurfaceHoverBrush}" />
                    <Setter Target="SelectionBar.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="PressedSelected">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuInsetSm}" />
                    <Setter Target="SelectionBar.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <VisualStateGroup x:Name="DisabledStates">
                <VisualState x:Name="Enabled" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Opacity" Value="{ThemeResource NeuInkDisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <utu:ShadowContainer x:Name="Surface"
                                 Background="{TemplateBinding Background}"
                                 CornerRadius="{TemplateBinding CornerRadius}"
                                 Shadows="{ThemeResource NeuRaisedSm}">
              <Grid x:Name="ContentPresenterGrid" CornerRadius="{TemplateBinding CornerRadius}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Rectangle x:Name="SelectionBar"
                           Grid.Column="0"
                           Width="3"
                           Height="21"
                           RadiusX="1.5"
                           RadiusY="1.5"
                           Margin="5,0,0,0"
                           Fill="{ThemeResource NeuAccentBrush}"
                           VerticalAlignment="Center"
                           Opacity="0" />

                <ContentPresenter x:Name="ContentPresenter"
                                  Grid.Column="1"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
            </utu:ShadowContainer>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The list itself is only a container: no chrome, no padding of its own, and
    no background, so rows sit directly on the slab.
  -->
  <Style x:Key="NeuListViewStyle" TargetType="ListView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource NeuListViewItemStyle}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

</ResourceDictionary>
