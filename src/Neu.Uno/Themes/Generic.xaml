<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:neu="using:Neu.Uno">

  <!--
    Default templates for the Neu primitives. Each follows the anatomy in
    CLAUDE.md: the ShadowContainer carries the surface brush and the child
    carries none, or the inset shadows will not paint.

    CornerRadius is set on the container AND on the child, because the container
    mimics its content's shape by size and corner radius while the anatomy puts
    the radius on the container itself. Setting both satisfies both.
  -->

  <!-- NeuSurface -->

  <Style TargetType="neu:NeuSurface">
    <Setter Property="Background" Value="{ThemeResource NeuSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource NeuRadiusMd}" />
    <Setter Property="Padding" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="neu:NeuSurface">
          <utu:ShadowContainer x:Name="Surface"
                               Background="{TemplateBinding Background}"
                               CornerRadius="{TemplateBinding CornerRadius}"
                               Shadows="{ThemeResource NeuRaisedMd}">

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="DepthStates">
                <VisualState x:Name="RaisedMd" />
                <VisualState x:Name="Flat">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuFlat}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RaisedSm">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuRaisedSm}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RaisedLg">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuRaisedLg}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InsetSm">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuInsetSm}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InsetMd">
                  <VisualState.Setters>
                    <Setter Target="Surface.Shadows" Value="{ThemeResource NeuInsetMd}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </utu:ShadowContainer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- NeuWell -->

  <Style TargetType="neu:NeuWell">
    <Setter Property="Background" Value="{ThemeResource NeuSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="CornerRadius" Value="{ThemeResource NeuRadiusMd}" />
    <Setter Property="Padding" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="neu:NeuWell">
          <utu:ShadowContainer Background="{TemplateBinding Background}"
                               CornerRadius="{TemplateBinding CornerRadius}"
                               Shadows="{ThemeResource NeuInsetMd}">
            <Grid CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </utu:ShadowContainer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- NeuGroove -->

  <Style TargetType="neu:NeuGroove">
    <Setter Property="Height" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="neu:NeuGroove">
          <StackPanel>
            <Border Height="1">
              <Border.Background>
                <SolidColorBrush Color="{ThemeResource NeuShadowDark}"
                                 Opacity="{ThemeResource NeuShadowDarkOpacity}" />
              </Border.Background>
            </Border>
            <Border Height="1">
              <Border.Background>
                <SolidColorBrush Color="{ThemeResource NeuShadowLight}"
                                 Opacity="{ThemeResource NeuShadowLightOpacity}" />
              </Border.Background>
            </Border>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
