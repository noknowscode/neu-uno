<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Neu color tokens. The only file in the library that may contain hex values
    (CLAUDE.md rule 9). Values come from the Design Brief table in docs/SPEC.md.

    Canvas and control share one color; depth carries the meaning. NeuCanvas and
    NeuSurface are deliberately the same value and are both declared so markup can
    say what it means.

    Shadow colors are stored opaque; their alpha lives in the companion
    *Opacity doubles because utu:Shadow takes Color and Opacity separately.

    NeuOnAccent / NeuOnAlert are the ink that sits on top of the amber and red
    fills. Both are the light-theme dark ink in BOTH themes: light ink on the dark
    accent measures 1.83:1 and is unusable. See tools/contrast-check.ps1.

    "Default" mirrors "Light" so a HighContrast request resolves instead of
    throwing. Step 9 replaces it with the real NeuHighContrast dictionary.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="NeuCanvas">#E9E3DC</Color>
      <Color x:Key="NeuSurface">#E9E3DC</Color>
      <Color x:Key="NeuShadowLight">#FFFFFF</Color>
      <Color x:Key="NeuShadowDark">#B9AFA4</Color>
      <Color x:Key="NeuInk">#1F1F1E</Color>
      <Color x:Key="NeuInkSecondary">#5F5A55</Color>
      <Color x:Key="NeuAccent">#C99436</Color>
      <Color x:Key="NeuAlert">#B5493A</Color>
      <Color x:Key="NeuOnAccent">#1F1F1E</Color>
      <Color x:Key="NeuOnAlert">#1F1F1E</Color>

      <x:Double x:Key="NeuShadowLightOpacity">0.72</x:Double>
      <x:Double x:Key="NeuShadowDarkOpacity">0.55</x:Double>

      <SolidColorBrush x:Key="NeuCanvasBrush" Color="#E9E3DC" />
      <SolidColorBrush x:Key="NeuSurfaceBrush" Color="#E9E3DC" />
      <SolidColorBrush x:Key="NeuInkBrush" Color="#1F1F1E" />
      <SolidColorBrush x:Key="NeuInkSecondaryBrush" Color="#5F5A55" />
      <SolidColorBrush x:Key="NeuAccentBrush" Color="#C99436" />
      <SolidColorBrush x:Key="NeuAlertBrush" Color="#B5493A" />
      <SolidColorBrush x:Key="NeuOnAccentBrush" Color="#1F1F1E" />
      <SolidColorBrush x:Key="NeuOnAlertBrush" Color="#1F1F1E" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="NeuCanvas">#2C2B29</Color>
      <Color x:Key="NeuSurface">#2C2B29</Color>
      <Color x:Key="NeuShadowLight">#3D3B38</Color>
      <Color x:Key="NeuShadowDark">#151412</Color>
      <Color x:Key="NeuInk">#ECE7E1</Color>
      <Color x:Key="NeuInkSecondary">#A39D96</Color>
      <Color x:Key="NeuAccent">#D9A441</Color>
      <Color x:Key="NeuAlert">#D9685A</Color>
      <Color x:Key="NeuOnAccent">#1F1F1E</Color>
      <Color x:Key="NeuOnAlert">#1F1F1E</Color>

      <x:Double x:Key="NeuShadowLightOpacity">0.55</x:Double>
      <x:Double x:Key="NeuShadowDarkOpacity">0.70</x:Double>

      <SolidColorBrush x:Key="NeuCanvasBrush" Color="#2C2B29" />
      <SolidColorBrush x:Key="NeuSurfaceBrush" Color="#2C2B29" />
      <SolidColorBrush x:Key="NeuInkBrush" Color="#ECE7E1" />
      <SolidColorBrush x:Key="NeuInkSecondaryBrush" Color="#A39D96" />
      <SolidColorBrush x:Key="NeuAccentBrush" Color="#D9A441" />
      <SolidColorBrush x:Key="NeuAlertBrush" Color="#D9685A" />
      <SolidColorBrush x:Key="NeuOnAccentBrush" Color="#1F1F1E" />
      <SolidColorBrush x:Key="NeuOnAlertBrush" Color="#1F1F1E" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Default">
      <Color x:Key="NeuCanvas">#E9E3DC</Color>
      <Color x:Key="NeuSurface">#E9E3DC</Color>
      <Color x:Key="NeuShadowLight">#FFFFFF</Color>
      <Color x:Key="NeuShadowDark">#B9AFA4</Color>
      <Color x:Key="NeuInk">#1F1F1E</Color>
      <Color x:Key="NeuInkSecondary">#5F5A55</Color>
      <Color x:Key="NeuAccent">#C99436</Color>
      <Color x:Key="NeuAlert">#B5493A</Color>
      <Color x:Key="NeuOnAccent">#1F1F1E</Color>
      <Color x:Key="NeuOnAlert">#1F1F1E</Color>

      <x:Double x:Key="NeuShadowLightOpacity">0.72</x:Double>
      <x:Double x:Key="NeuShadowDarkOpacity">0.55</x:Double>

      <SolidColorBrush x:Key="NeuCanvasBrush" Color="#E9E3DC" />
      <SolidColorBrush x:Key="NeuSurfaceBrush" Color="#E9E3DC" />
      <SolidColorBrush x:Key="NeuInkBrush" Color="#1F1F1E" />
      <SolidColorBrush x:Key="NeuInkSecondaryBrush" Color="#5F5A55" />
      <SolidColorBrush x:Key="NeuAccentBrush" Color="#C99436" />
      <SolidColorBrush x:Key="NeuAlertBrush" Color="#B5493A" />
      <SolidColorBrush x:Key="NeuOnAccentBrush" Color="#1F1F1E" />
      <SolidColorBrush x:Key="NeuOnAlertBrush" Color="#1F1F1E" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
