<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Metric, radius and spacing tokens. Theme-invariant: depth never changes with
    theme or width, only the shadow colors do.

    Depth: each collection is two shadows, NeuShadowDark at (+offset, +offset)
    first and NeuShadowLight at (-offset, -offset) second. The ShadowCollection
    resources that consume these land in Tokens.Shadows.xaml in step 3; the raw
    numbers live here so a consumer can restate one value instead of a collection.
  -->

  <!-- Depth scale: offsets -->
  <x:Double x:Key="NeuDepthSmOffset">3</x:Double>
  <x:Double x:Key="NeuDepthMdOffset">6</x:Double>
  <x:Double x:Key="NeuDepthLgOffset">10</x:Double>

  <!-- Depth scale: negated offsets for the light shadow of each pair -->
  <x:Double x:Key="NeuDepthSmOffsetNegative">-3</x:Double>
  <x:Double x:Key="NeuDepthMdOffsetNegative">-6</x:Double>
  <x:Double x:Key="NeuDepthLgOffsetNegative">-10</x:Double>

  <!-- Depth scale: blur -->
  <x:Double x:Key="NeuDepthSmBlur">6</x:Double>
  <x:Double x:Key="NeuDepthMdBlur">12</x:Double>
  <x:Double x:Key="NeuDepthLgBlur">24</x:Double>

  <!-- Depth scale: spread -->
  <x:Double x:Key="NeuDepthSmSpread">0</x:Double>
  <x:Double x:Key="NeuDepthMdSpread">0</x:Double>
  <x:Double x:Key="NeuDepthLgSpread">-2</x:Double>

  <!--
    Focus ring: a second ShadowContainer layered behind the surface, spread 2,
    blur 0, painted in NeuAccent (NeuAlert in the error state).
  -->
  <x:Double x:Key="NeuFocusRingSpread">2</x:Double>
  <x:Double x:Key="NeuFocusRingBlur">0</x:Double>

  <!--
    Radius. Surfaces use Sm/Md, interactives use Md/Pill.

    NeuRadiusPill is the WinUI 999 idiom and the Skia renderer reduces it per
    axis rather than clamping to a circle, so a wide short control gets an oval
    rather than a pill. Pill-shaped templates should override CornerRadius with
    half their own height; NeuRadiusPill stays here as the declared token.
  -->
  <CornerRadius x:Key="NeuRadiusSm">8</CornerRadius>
  <CornerRadius x:Key="NeuRadiusMd">13</CornerRadius>
  <CornerRadius x:Key="NeuRadiusLg">21</CornerRadius>
  <CornerRadius x:Key="NeuRadiusPill">999</CornerRadius>

  <!-- Scalar companions, for templates that need the number rather than the struct -->
  <x:Double x:Key="NeuRadiusSmValue">8</x:Double>
  <x:Double x:Key="NeuRadiusMdValue">13</x:Double>
  <x:Double x:Key="NeuRadiusLgValue">21</x:Double>
  <x:Double x:Key="NeuRadiusPillValue">999</x:Double>

  <!--
    Spacing, Fibonacci. Rule: shadow offset < gap between sibling containers,
    so Md depth (offset 6) needs at least NeuSpace13 between siblings.
  -->
  <x:Double x:Key="NeuSpace3">3</x:Double>
  <x:Double x:Key="NeuSpace5">5</x:Double>
  <x:Double x:Key="NeuSpace8">8</x:Double>
  <x:Double x:Key="NeuSpace13">13</x:Double>
  <x:Double x:Key="NeuSpace21">21</x:Double>
  <x:Double x:Key="NeuSpace34">34</x:Double>

  <!-- Ink opacity in the disabled state, paired with NeuFlat depth -->
  <x:Double x:Key="NeuInkDisabledOpacity">0.38</x:Double>

  <!-- Minimum touch target -->
  <x:Double x:Key="NeuTouchTargetMin">44</x:Double>

  <!--
    Motion. House values from xaml-design-polish: one easing curve for every
    transition, fast/normal durations, a firm 0.98 press. The press signature is
    Raised -> Flat -> Inset. The Flat midpoint holds for 75ms, half the fast
    duration; KeyTime has no resource form, so templates inline 0:0:0.075.
  -->
  <KeySpline x:Key="NeuEaseSmooth" ControlPoint1="0.22,1" ControlPoint2="0.36,1" />
  <Duration x:Key="NeuDurationFast">0:0:0.150</Duration>
  <Duration x:Key="NeuDurationNormal">0:0:0.200</Duration>
  <x:Double x:Key="NeuPressScale">0.98</x:Double>

</ResourceDictionary>
