<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Type ramp. Size, weight and line height only: the library ships no fonts
    (CLAUDE.md rule 10, decision D5). FontFamily is the consumer's choice, so no
    style below sets one - Data is nominally mono and the app supplies the face.

    Both forms are provided: raw doubles for templates that compose their own
    text, and TextBlock styles for markup that just wants the role. Weight has no
    scalar form because FontWeight is a struct, so it is carried by the styles.
  -->

  <x:Double x:Key="NeuDisplayFontSize">34</x:Double>
  <x:Double x:Key="NeuDisplayLineHeight">40</x:Double>

  <x:Double x:Key="NeuTitleFontSize">21</x:Double>
  <x:Double x:Key="NeuTitleLineHeight">28</x:Double>

  <x:Double x:Key="NeuBodyFontSize">16</x:Double>
  <x:Double x:Key="NeuBodyLineHeight">24</x:Double>

  <x:Double x:Key="NeuLabelFontSize">13</x:Double>
  <x:Double x:Key="NeuLabelLineHeight">16</x:Double>

  <x:Double x:Key="NeuDataFontSize">13</x:Double>
  <x:Double x:Key="NeuDataLineHeight">16</x:Double>

  <!--
    Label tracking is +0.4px at 13px, which is 30 units of CharacterSpacing
    (1 unit = 1/1000 em). TextBlock.CharacterSpacing is currently a silent no-op
    on the Uno Skia text stack, so the value is declared and will start applying
    when the text stack supports it.
  -->
  <x:Double x:Key="NeuLabelCharacterSpacing">30</x:Double>

  <Style x:Key="NeuDisplay" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource NeuDisplayFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource NeuDisplayLineHeight}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="NeuTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource NeuTitleFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource NeuTitleLineHeight}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="NeuBody" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource NeuBodyFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource NeuBodyLineHeight}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="NeuLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource NeuLabelFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource NeuLabelLineHeight}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CharacterSpacing" Value="{StaticResource NeuLabelCharacterSpacing}" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="NeuData" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource NeuDataFontSize}" />
    <Setter Property="LineHeight" Value="{StaticResource NeuDataLineHeight}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{ThemeResource NeuInkSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

</ResourceDictionary>
