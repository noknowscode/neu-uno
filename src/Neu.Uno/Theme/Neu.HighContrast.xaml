                    BlurRadius="{StaticResource NeuHighContrastBlur}"
                    Spread="{StaticResource NeuHighContrastOutlineSpread}"
                    Color="{StaticResource NeuInk}"
                    Opacity="1" />
      </utu:ShadowCollection>

      <utu:ShadowCollection x:Key="NeuRaisedLg">
        <utu:Shadow IsInner="True"
                    OffsetX="0"
                    OffsetY="0"
                    BlurRadius="{StaticResource NeuHighContrastBlur}"
                    Spread="{StaticResource NeuHighContrastOutlineSpread}"
                    Color="{StaticResource NeuInk}"
                    Opacity="1" />
      </utu:ShadowCollection>

      <utu:ShadowCollection x:Key="NeuInsetSm">
        <utu:Shadow IsInner="True"
