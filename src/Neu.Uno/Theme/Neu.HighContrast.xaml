                    OffsetY="0"
                    BlurRadius="{StaticResource NeuHighContrastBlur}"
                    Spread="{StaticResource NeuHighContrastRingSpread}"
                    Color="{StaticResource NeuAlert}"
                    Opacity="1" />
      </utu:ShadowCollection>
    </ResourceDictionary>

