                    OffsetY="{StaticResource NeuDepthMdOffset}"
                    BlurRadius="{StaticResource NeuDepthMdBlur}"
                    Spread="{StaticResource NeuDepthMdSpread}"
                    Color="{StaticResource NeuShadowDark}"
                    Opacity="{StaticResource NeuShadowDarkOpacity}"
                    IsInner="True" />
        <utu:Shadow OffsetX="{StaticResource NeuDepthMdOffsetNegative}"
