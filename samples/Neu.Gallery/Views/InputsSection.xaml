<UserControl x:Class="Neu.Gallery.Views.InputsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
             xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    Step 7 specimens: TextBox, PasswordBox, NumberBox, ComboBox. Every field is
    an InsetSm well; focus is the amber ring behind it.

    Under NEU_GALLERY_STATE=1 the code-behind focuses the tagged field and writes
    what actually happened into the caption beside it, so a headless capture
    reports the real FocusState instead of leaving it ambiguous.
  -->
  <StackPanel Spacing="34">

    <StackPanel Spacing="13">
      <TextBlock Style="{StaticResource NeuTitle}" Text="Inputs" />
      <TextBlock Style="{StaticResource NeuBody}"
                 Foreground="{ThemeResource NeuInkSecondaryBrush}"
                 Text="A field is a hole in the slab, not an extrusion: InsetSm well, no stroke. Focus adds a 2px amber ring behind the well, spread 2, blur 0." />

      <StackPanel Orientation="Horizontal" Spacing="34" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <TextBox Style="{StaticResource NeuTextBoxStyle}" Text="Molded" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="Rest" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBox Style="{StaticResource NeuTextBoxStyle}" PlaceholderText="Placeholder" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="Empty" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBox x:Name="FocusProbeBox" Style="{StaticResource NeuTextBoxStyle}" Text="Focused" />
          <TextBlock x:Name="FocusReport" Style="{StaticResource NeuLabel}" Text="Focused" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBox Style="{StaticResource NeuTextBoxStyle}" Text="Molded" IsEnabled="False" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="Disabled" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="34" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <PasswordBox Style="{StaticResource NeuPasswordBoxStyle}" Password="secret" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="PasswordBox" />
        </StackPanel>
        <StackPanel Spacing="8">
          <muxc:NumberBox Style="{StaticResource NeuNumberBoxStyle}" Value="8" SpinButtonPlacementMode="Inline" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="NumberBox, inline spin" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="34" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <ComboBox Style="{StaticResource NeuComboBoxStyle}" SelectedIndex="1">
            <ComboBoxItem Content="Raised" />
            <ComboBoxItem Content="Inset" />
            <ComboBoxItem Content="Flat" />
          </ComboBox>
          <TextBlock Style="{StaticResource NeuLabel}" Text="ComboBox" />
        </StackPanel>
        <StackPanel Spacing="8">
          <ComboBox Style="{StaticResource NeuComboBoxStyle}" PlaceholderText="Pick a depth" IsEnabled="False" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="Disabled" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="13">
      <TextBlock Style="{StaticResource NeuTitle}" Text="Error" />
      <TextBlock Style="{StaticResource NeuBody}"
                 Foreground="{ThemeResource NeuInkSecondaryBrush}"
                 Text="Composed by the app, not by the control: WinUI inputs have no error state, so the field is wrapped in a container wearing NeuAlertRing and the message goes below in NeuAlert ink." />

      <StackPanel Spacing="5" HorizontalAlignment="Left">
        <utu:ShadowContainer Background="{ThemeResource NeuSurfaceBrush}"
                             CornerRadius="{ThemeResource NeuRadiusMd}"
                             Shadows="{ThemeResource NeuAlertRing}"
                             HorizontalAlignment="Left">
          <TextBox Style="{StaticResource NeuTextBoxStyle}" Text="not-an-email" />
        </utu:ShadowContainer>
        <TextBlock Style="{StaticResource NeuLabel}"
                   Foreground="{ThemeResource NeuAlertBrush}"
                   Text="Enter a valid address." />
      </StackPanel>
    </StackPanel>

  </StackPanel>
</UserControl>
