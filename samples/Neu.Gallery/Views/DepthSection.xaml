<UserControl x:Class="Neu.Gallery.Views.DepthSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:neu="using:Neu.Uno">

  <!--
    The six depth collections on identical NeuSurface specimens, then the two
    other primitives. Every specimen is the same size and radius so the only
    variable on the sheet is depth.

    Specimens are 34 apart: Md depth offsets 6 and Lg offsets 10, and the rule is
    offset < gap, so 21 would be too tight for the Lg row to breathe.
  -->
  <StackPanel Spacing="34">

    <StackPanel Spacing="13">
      <TextBlock Style="{StaticResource NeuTitle}" Text="Depth" />
      <TextBlock Style="{StaticResource NeuBody}"
                 Foreground="{ThemeResource NeuInkSecondaryBrush}"
                 Text="Six named collections. Each is NeuShadowDark at the positive offset, then NeuShadowLight at the negative one." />

      <StackPanel Orientation="Horizontal" Spacing="34" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <neu:NeuSurface Depth="RaisedSm" Width="110" Height="76" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="NeuRaisedSm" />
        </StackPanel>
        <StackPanel Spacing="8">
          <neu:NeuSurface Depth="RaisedMd" Width="110" Height="76" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="NeuRaisedMd" />
        </StackPanel>
        <StackPanel Spacing="8">
          <neu:NeuSurface Depth="RaisedLg" Width="110" Height="76" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="NeuRaisedLg" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="34" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <neu:NeuSurface Depth="InsetSm" Width="110" Height="76" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="NeuInsetSm" />
        </StackPanel>
        <StackPanel Spacing="8">
          <neu:NeuSurface Depth="InsetMd" Width="110" Height="76" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="NeuInsetMd" />
        </StackPanel>
        <StackPanel Spacing="8">
          <neu:NeuSurface Depth="Flat" Width="110" Height="76" />
          <TextBlock Style="{StaticResource NeuLabel}" Text="NeuFlat" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="13">
      <TextBlock Style="{StaticResource NeuTitle}" Text="Primitives" />
      <TextBlock Style="{StaticResource NeuBody}"
                 Foreground="{ThemeResource NeuInkSecondaryBrush}"
                 Text="NeuSurface takes any depth. NeuWell is always a hole. NeuGroove carries no shadow at all." />

      <StackPanel Orientation="Horizontal" Spacing="34" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <neu:NeuSurface Width="178" Height="76" VerticalContentAlignment="Center">
            <TextBlock Style="{StaticResource NeuBody}"
                       HorizontalAlignment="Center"
                       Text="Extruded" />
          </neu:NeuSurface>
          <TextBlock Style="{StaticResource NeuLabel}" Text="NeuSurface" />
        </StackPanel>
        <StackPanel Spacing="8">
          <neu:NeuWell Width="178" Height="76" VerticalContentAlignment="Center">
            <TextBlock Style="{StaticResource NeuBody}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource NeuInkSecondaryBrush}"
                       Text="Recessed" />
          </neu:NeuWell>
          <TextBlock Style="{StaticResource NeuLabel}" Text="NeuWell" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="8" MaxWidth="390" HorizontalAlignment="Left">
        <neu:NeuGroove />
        <TextBlock Style="{StaticResource NeuLabel}" Text="NeuGroove" />
      </StackPanel>

      <!--
        The step-4 gate: a surface whose Depth changes long after first paint,
        driven by NEU_GALLERY_PRESS=1. Proves the VSM shadow swap is a live
        state change and not just a template-time value.
      -->
      <StackPanel Spacing="8" HorizontalAlignment="Left">
        <neu:NeuSurface x:Name="SwapSpecimen"
                        Depth="RaisedMd"
                        HorizontalAlignment="Left"
                        Width="178"
                        Height="76"
                        VerticalContentAlignment="Center">
          <TextBlock Style="{StaticResource NeuBody}"
                     HorizontalAlignment="Center"
                     Text="Swap" />
        </neu:NeuSurface>
        <TextBlock Style="{StaticResource NeuLabel}"
                   Text="RaisedMd, InsetSm under NEU_GALLERY_PRESS" />
      </StackPanel>
    </StackPanel>

  </StackPanel>
</UserControl>
